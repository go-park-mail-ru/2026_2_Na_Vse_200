# Go on this computer + PostgreSQL from: docker compose up -d --wait db
# Add these to an existing .env without replacing unrelated settings.
POSTGRES_DSN=postgres://music@localhost:5433/music?sslmode=disable
PGPASSWORD=music_local_dev
APP_ADDR=:8080

# For a separate local PostgreSQL, replace the two database settings above:
# POSTGRES_DSN=postgres://postgres@localhost:5432/music_hw2?sslmode=disable
# PGPASSWORD=YOUR_PASSWORD

# Docker Compose has local defaults and does not require .env.
# Optional overrides below are independent of POSTGRES_DSN above.
# Choose a different password before the FIRST creation of the Docker database.
# DOCKER_POSTGRES_PASSWORD=music_local_dev
# DOCKER_POSTGRES_PORT=5433
# DOCKER_HTTP_PORT=8080
