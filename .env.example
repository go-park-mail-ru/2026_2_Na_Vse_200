# Шаблон настроек: cp .env.example .env

# Адрес, который слушает сервер.
APP_ADDR=:8080

# Адрес фронтенда для CORS. Пусто — фронтенд и API на одном origin.
APP_ALLOWED_ORIGIN=http://localhost:3000

# Флаг Secure у сессионной cookie. Обязателен, когда задан APP_ALLOWED_ORIGIN:
# при разных адресах cookie уходит с SameSite=None, а её браузер без Secure
# отвергает. На localhost Secure работает и поверх http.
APP_COOKIE_SECURE=true

# Срок жизни сессии.
APP_SESSION_TTL=24h

# Сколько ждать завершения запросов при остановке.
APP_SHUTDOWN_TIMEOUT=10s

# Строка подключения к PostgreSQL.
POSTGRES_DSN=postgres://<user>:<password>@<host>:5432/<database>?sslmode=disable
