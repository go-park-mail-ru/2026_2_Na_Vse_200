# Шаблон настроек: cp .env.example .env
# Все переменные необязательные, значений по умолчанию хватает для локального запуска.

# Адрес, который слушает сервер.
APP_ADDR=:8080

# Адрес фронтенда для CORS. Пусто — фронтенд и API на одном origin.
APP_ALLOWED_ORIGIN=http://localhost:3000

# Флаг Secure у сессионной cookie. По http:// должен быть false.
APP_COOKIE_SECURE=false

# Срок жизни сессии.
APP_SESSION_TTL=24h

# Сколько ждать завершения запросов при остановке.
APP_SHUTDOWN_TIMEOUT=10s

# Строка подключения к PostgreSQL. Пока не используется.
POSTGRES_DSN=postgres://navse200:navse200@localhost:5432/navse200?sslmode=disable
