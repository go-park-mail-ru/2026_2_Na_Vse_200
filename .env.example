# Docker Compose использует значения по умолчанию без .env.
# Для изменения настроек добавьте нужные переменные в .env.
# Пароль задаётся перед первым созданием базы в Docker.
# DOCKER_POSTGRES_PASSWORD=music_local_dev
# DOCKER_POSTGRES_PORT=5433
# DOCKER_HTTP_PORT=8080
# APP_ALLOWED_ORIGIN=http://localhost:3000
# APP_COOKIE_SECURE=false
# APP_SESSION_TTL=24h
# APP_SHUTDOWN_TIMEOUT=10s

# Native server: folder containing storage_key paths from media_file.
# MEDIA_ROOT=media
