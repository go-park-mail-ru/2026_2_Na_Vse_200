# Шаблон настроек. Скопируйте в .env и поправьте под себя:
#     cp .env.example .env
# Файл .env в репозиторий не попадает.
#
# Запуск с этими настройками: ./scripts/run.sh
# Все переменные необязательные: без .env сервис поднимается на значениях
# по умолчанию, пригодных для локальной разработки.

# Адрес, который слушает сервер.
APP_ADDR=:8080

# Адрес фронтенда для CORS. Пусто — CORS не нужен: фронтенд и API
# на одном origin. Адрес ровно один, списка намеренно нет.
APP_ALLOWED_ORIGIN=http://localhost:3000

# Флаг Secure у сессионной cookie. Локально false: по http:// браузер
# cookie с этим флагом не примет. На стенде с HTTPS — true.
APP_COOKIE_SECURE=false

# Срок жизни сессии и cookie.
APP_SESSION_TTL=24h

# Сколько ждём завершения текущих запросов при остановке сервера.
APP_SHUTDOWN_TIMEOUT=10s

# Строка подключения к PostgreSQL. Пока не используется: аккаунты
# хранятся в памяти процесса до готовности слоя поверх базы.
POSTGRES_DSN=postgres://navse200:navse200@localhost:5432/navse200?sslmode=disable
