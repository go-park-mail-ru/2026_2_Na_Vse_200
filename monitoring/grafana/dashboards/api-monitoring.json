{
  "uid": "api-monitoring",
  "title": "2une · мониторинг",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Сервис",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(http_requests_total, service)",
        "query": {
          "query": "label_values(http_requests_total, service)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "route",
        "label": "Маршрут",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(http_requests_total{service=~\"$service\",route!=\"/health\",route!=\"/metrics\"}, route)",
        "query": {
          "query": "label_values(http_requests_total{service=~\"$service\",route!=\"/health\",route!=\"/metrics\"}, route)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Запросы в секунду",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "noValue": "—",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "refId": "A",
          "expr": "sum(rate(http_requests_total{service=~\"$service\",route=~\"$route\",route!=\"/health\",route!=\"/metrics\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Доля 5xx",
      "type": "stat",
      "gridPos": {"x": 8, "y": 0, "w": 8, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "noValue": "—",
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "refId": "A",
          "expr": "100 * ((sum(rate(http_requests_total{service=~\"$service\",route=~\"$route\",route!=\"/health\",route!=\"/metrics\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / (sum(rate(http_requests_total{service=~\"$service\",route=~\"$route\",route!=\"/health\",route!=\"/metrics\"}[$__rate_interval])) > 0))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "p95 задержки",
      "type": "stat",
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "noValue": "—",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "refId": "A",
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service=~\"$service\",route=~\"$route\",route!=\"/health\",route!=\"/metrics\"}[$__rate_interval]))) and (sum(rate(http_requests_total{service=~\"$service\",route=~\"$route\",route!=\"/health\",route!=\"/metrics\"}[$__rate_interval])) > 0)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "description": "Оценка времени, в которое укладывается 95% запросов.",
      "options": {
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Трафик по маршрутам",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "noValue": "—",
          "min": 0,
          "custom": {"fillOpacity": 10, "lineWidth": 2, "showPoints": "never"}
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "refId": "A",
          "expr": "sum by (service, method, route) (rate(http_requests_total{service=~\"$service\",route=~\"$route\",route!=\"/health\",route!=\"/metrics\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{route}} · {{service}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc", "hideZeros": true},
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 5,
      "title": "p95 по маршрутам",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "noValue": "—",
          "min": 0,
          "custom": {"fillOpacity": 10, "lineWidth": 2, "showPoints": "never"}
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "refId": "A",
          "expr": "1000 * histogram_quantile(0.95, sum by (le, service, method, route) (rate(http_request_duration_seconds_bucket{service=~\"$service\",route=~\"$route\",route!=\"/health\",route!=\"/metrics\"}[$__rate_interval]))) and on (service, method, route) (sum by (service, method, route) (rate(http_requests_total{service=~\"$service\",route=~\"$route\",route!=\"/health\",route!=\"/metrics\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{method}} {{route}} · {{service}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc", "hideZeros": true},
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 6,
      "title": "Ответы 4xx и 5xx",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "noValue": "—",
          "min": 0,
          "custom": {"fillOpacity": 10, "lineWidth": 2, "showPoints": "never"}
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "refId": "A",
          "expr": "sum by (service, method, route, status) (rate(http_requests_total{service=~\"$service\",route=~\"$route\",route!=\"/health\",route!=\"/metrics\",status=~\"[45]..\"}[$__rate_interval]))",
          "legendFormat": "{{status}} · {{method}} {{route}} · {{service}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc", "hideZeros": true},
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 7,
      "title": "Запросы по маршрутам",
      "type": "table",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "noValue": "—"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "refId": "A",
          "expr": "sum by (service, method, route) (rate(http_requests_total{service=~\"$service\",route=~\"$route\",route!=\"/health\",route!=\"/metrics\"}[$__rate_interval]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {"mode": "columns"}
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "service": 0,
              "method": 1,
              "route": 2,
              "Value": 3
            },
            "renameByName": {
              "service": "Сервис",
              "method": "Метод",
              "route": "Маршрут",
              "Value": "Запросов/с"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Запросов/с",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 8,
      "title": "Ресурсы Linux-хоста",
      "type": "row",
      "gridPos": {"x": 0, "y": 20, "w": 24, "h": 1},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 9,
      "title": "Загрузка CPU",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 21, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "noValue": "—",
          "min": 0,
          "custom": {"fillOpacity": 10, "lineWidth": 2, "showPoints": "never"},
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "refId": "A",
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc", "hideZeros": true},
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 10,
      "title": "Занятая память",
      "type": "timeseries",
      "gridPos": {"x": 8, "y": 21, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: МиБ",
          "decimals": 0,
          "noValue": "—",
          "min": 0,
          "custom": {"fillOpacity": 10, "lineWidth": 2, "showPoints": "never"}
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "refId": "A",
          "expr": "(node_memory_MemTotal_bytes{job=\"node\"} - node_memory_MemAvailable_bytes{job=\"node\"}) / 1024 / 1024",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc", "hideZeros": true},
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 11,
      "title": "Занято на диске",
      "type": "timeseries",
      "gridPos": {"x": 16, "y": 21, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "noValue": "—",
          "min": 0,
          "custom": {"fillOpacity": 10, "lineWidth": 2, "showPoints": "never"},
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"node\",mountpoint=~\"/|/mnt/docker-desktop-disk\"} / node_filesystem_size_bytes{job=\"node\",mountpoint=~\"/|/mnt/docker-desktop-disk\"})",
          "legendFormat": "{{mountpoint}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "description": "Корневой раздел Linux или диск данных Docker Desktop.",
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc", "hideZeros": true},
        "legend": {
          "showLegend": false
        }
      }
    }
  ]
}
